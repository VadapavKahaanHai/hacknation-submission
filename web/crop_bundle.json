   "entity_id": "coffee_healthy",
   "field": "name",
   "lang": "hi",
   "text": "स्वस्थ",
   "review_status": "unverified"
  },
  {
   "entity_type": "disease",
   "entity_id": "coffee_leaf_rust",
   "field": "summary",
   "lang": "hi",
   "text": "यह फफूंद हवा और बारिश की छींटों से फैलती है। यह पेड़ की ज़्यादातर पत्तियाँ गिरा सकती है और अगले मौसम की फ़सल घटा सकती है।",
   "review_status": "unverified"
  },
  {
   "entity_type": "disease",
   "entity_id": "coffee_leaf_rust",
   "field": "why",
   "lang": "hi",
   "text": "पत्तियों के नीचे नारंगी पीला चूर्ण, और ऊपर हल्के पीले धब्बे।",
   "review_status": "unverified"
  },
  {
   "entity_type": "symptom",
   "entity_id": "5",
   "field": "text",
   "lang": "hi",
   "text": "पत्तियों के नीचे नारंगी पीला चूर्ण",
   "review_status": "unverified"
  },
  {
   "entity_type": "symptom",
   "entity_id": "6",
   "field": "text",
   "lang": "hi",
   "text": "पत्ती के ऊपर हल्के पीले धब्बे",
   "review_status": "unverified"
  },
  {
   "entity_type": "symptom",
   "entity_id": "7",
   "field": "text",
   "lang": "hi",
   "text": "बहुत सी पत्तियाँ जल्दी गिरना",
   "review_status": "unverified"
  },
  {
   "entity_type": "advice",
   "entity_id": "7",
   "field": "text",
   "lang": "hi",
   "text": "घनी शाखाओं की छँटाई करें ताकि पत्तियों तक हवा और रोशनी पहुँचे। बहुत बीमार गिरी हुई पत्तियाँ इकट्ठा करके गाड़ दें।",
   "review_status": "unverified"
  },
  {
   "entity_type": "advice",
   "entity_id": "8",
   "field": "text",
   "lang": "hi",
   "text": "अपने क्षेत्र में कॉफ़ी रतुआ के लिए स्वीकृत फफूंदनाशक का प्रयोग करें। अपने कृषि अधिकारी से पूछें कि कौन सा।",
   "review_status": "unverified"
  },
  {
   "entity_type": "advice",
   "entity_id": "8",
   "field": "safety_note",
   "lang": "hi",
   "text": "मात्रा और कटाई से पहले के दिनों के लिए लेबल का पालन करें। दस्ताने और मास्क पहनें।",
   "review_status": "unverified"
  },
  {
   "entity_type": "advice",
   "entity_id": "9",
   "field": "text",
   "lang": "hi",
   "text": "दोबारा पौधे लगाते समय रतुआ प्रतिरोधी कॉफ़ी किस्में माँगें।",
   "review_status": "unverified"
  },
  {
   "entity_type": "advice",
   "entity_id": "10",
   "field": "text",
   "lang": "hi",
   "text": "पेड़ों को अच्छा पोषण दें और छाया संतुलित रखें। कमज़ोर पेड़ ज़्यादा प्रभावित होते हैं।",
   "review_status": "unverified"
  },
  {
   "entity_type": "question",
   "entity_id": "q_coffee_orange_powder",
   "field": "text",
   "lang": "hi",
   "text": "क्या धब्बों के नीचे नारंगी या पीला चूर्ण है?",
   "review_status": "unverified"
  },
  {
   "entity_type": "ui",
   "entity_id": "disclaimer",
   "field": "text",
   "lang": "hi",
   "text": "यह कंप्यूटर का अनुमान है, जाँच नहीं। कुछ भी छिड़कने से पहले अपने कृषि अधिकारी या कृषि विक्रेता से पूछें।",
   "review_status": "unverified"
  },
  {
   "entity_type": "ui",
   "entity_id": "retake",
   "field": "text",
   "lang": "hi",
   "text": "हम यह फ़ोटो नहीं पढ़ पाए। एक पत्ती की, पास से, दिन की रोशनी में नई फ़ोटो लें।",
   "review_status": "unverified"
  },
  {
   "entity_type": "ui",
   "entity_id": "uncertain",
   "field": "text",
   "lang": "hi",
   "text": "हमें पक्का नहीं पता। कृपया एक या दो सवालों के जवाब दें।",
   "review_status": "unverified"
  },
  {
   "entity_type": "ui",
   "entity_id": "could_be",
   "field": "text",
   "lang": "hi",
   "text": "यह इनमें से कोई एक हो सकता है।",
   "review_status": "unverified"
  },
  {
   "entity_type": "ui",
   "entity_id": "see_expert",
   "field": "text",
   "lang": "hi",
   "text": "जल्द ही यह पत्ती किसी कृषि अधिकारी को दिखाएँ।",
   "review_status": "unverified"
  }
 ],
